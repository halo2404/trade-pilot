# TradePilot – Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_SECRET_KEY=changeme        # Random secret for session signing

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tradepilot:changeme@localhost:5432/tradepilot

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TradePilot

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=60

# ─── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Market Data ─────────────────────────────────────────────────────────────
# Add your market data provider API key here (e.g. Alpha Vantage, Polygon.io)
MARKET_DATA_API_KEY=

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
